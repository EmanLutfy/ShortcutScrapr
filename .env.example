# One token per person: name=token, comma separated. Each token at least 16 chars.
# Make one with: openssl rand -hex 24
TOKENS=me=CHANGE_ME_use_openssl_rand_hex_24

# Requests allowed per token per window (default 30 per 10 minutes).
RATE_LIMIT=30
RATE_WINDOW_MS=600000

# Set to 1 when running behind Caddy/nginx so rate limits see the real client IP.
TRUST_PROXY=1

# Docker port binding (see docker-compose.yml).
BIND=127.0.0.1
HOST_PORT=3010

# Domain for HTTPS (docker-compose.https.yml).
DOMAIN=dl.example.com
